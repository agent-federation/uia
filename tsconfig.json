{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "outDir": "build",
    "rootDir": ".",
    "rootDirs": [".", "contract-builder", "../contract-builder"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "contracts/**/*.ts", "profiles/**/*.ts"],
  "exclude": ["node_modules", "build", "contract-builder"]
}
